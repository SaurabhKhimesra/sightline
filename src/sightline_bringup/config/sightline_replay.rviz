Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 420
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 90; 90; 90
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: UR5e (recorded joint angles)
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      TF Prefix: ""
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.35
      Frame Timeout: 15
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Worker (the judge's capsules)
      Topic:
        Value: /sightline/worker
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Station
      Topic:
        Value: /sightline/station
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: The judge's record
      Topic:
        Value: /sightline/caption_image
        Depth: 5
        Reliability Policy: Reliable
      Normalize Range: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Eyes camera (from Gazebo)
      Topic:
        Value: /replay/eyes_cam
        Depth: 5
        Reliability Policy: Reliable
      Normalize Range: true
  Global Options:
    Fixed Frame: world
    Background Color: 38; 40; 44
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.0
      Focal Point:
        X: -0.1
        Y: -0.45
        Z: 1.25
      Pitch: 0.45
      Yaw: 3.7
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Eyes camera (from Gazebo):
    collapsed: false
  The judge's record:
    collapsed: false
  Height: 720
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ""
