# the stage 1 layout without the eyes camera panel: the pictures are not in the bag
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 90; 90; 90
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: UR5e
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      TF Prefix: ""
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Worker (the judge's truth)
      Topic:
        Value: /sightline/worker
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Station
      Topic:
        Value: /sightline/station
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: "Grid: where the camera sees him"
      Topic:
        Value: /sightline/grid/seen
        Depth: 5
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 4
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: "Grid: hidden by the arm, remembered"
      Topic:
        Value: /sightline/grid/remembered
        Depth: 5
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 4
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: "Grid: 15 cm behind him"
      Topic:
        Value: /sightline/grid/behind
        Depth: 5
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Alpha: 1
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: The 63 points the guard checks
      Topic:
        Value: /sightline/arm_points
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: The hole it is going for
      Topic:
        Value: /sightline/target
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: The judge's record
      Topic:
        Value: /sightline/caption_image
        Depth: 5
        Reliability Policy: Reliable
      Normalize Range: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: The planner
      Topic:
        Value: /sightline/planner_caption
        Depth: 5
        Reliability Policy: Reliable
      Normalize Range: false
  Global Options:
    Fixed Frame: world
    Background Color: 38; 40; 44
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.6
      Focal Point:
        X: -0.1
        Y: -0.45
        Z: 1.3
      Pitch: 0.5
      Yaw: 3.7
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  The judge's record:
    collapsed: false
  The planner:
    collapsed: false
  Height: 720
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ""
