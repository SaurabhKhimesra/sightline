<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sightline_ros</name>
  <version>0.1.0</version>
  <description>The ROS 2 layer: the cell and the planner as nodes in lockstep on sim time, the topic contract between them, and the live replay of a run into Gazebo Sim and rviz.</description>
  <maintainer email="learningkhimesra@gmail.com">Saurabh Khimesra</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>sightline_planner</depend>
  <depend>sightline_sim</depend>


  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
