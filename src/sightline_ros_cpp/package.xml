<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sightline_ros_cpp</name>
  <version>0.1.0</version>
  <description>The planner as a C++ ROS 2 node: B4 on the camera's grid, in lockstep with the cell node on sim time, and the topic contract the two share.</description>
  <maintainer email="learningkhimesra@gmail.com">Saurabh Khimesra</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>sightline_planner_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
